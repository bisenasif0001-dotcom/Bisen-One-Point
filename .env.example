# Production Node server. Keep actual values outside the source repository.
PUBLIC_ORIGIN=https://your-website.example
# Keep staging private. Set true only for the final domain after the launch checklist passes.
SITE_INDEXABLE=false
PORT=3000
HOST=127.0.0.1
# Set only when a trusted local reverse proxy overwrites X-Real-IP with the actual client IP.
TRUST_PROXY=1
# Persistent private directory. Back up both studio.sqlite and master.key together.
DATA_DIR=.studio-data
# Private same-disk snapshots. Arrange a separate protected off-site copy with your hosting.
BACKUP_DIR=.studio-data/backups
BACKUP_INTERVAL_HOURS=24
# A long random one-time code for creating the first production studio login.
STUDIO_BOOTSTRAP_TOKEN=
# Razorpay credentials are entered in the authenticated studio panel, never VITE_ variables.
